---
import '../index.css';
import { PETTOWN_DATA } from '../data/propertyData';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Cuida Filho Pet Shop | Banho, Tosa, Consulta Veterinária e Produtos Pet • Casa Forte",
  description = "Cuida Filho Pet Shop no Mateus Hiper Casa Forte. Banho & Tosa humanizado, Consulta Veterinária, Produtos de Saúde, Beleza e Alimentação com muito amor e carinho."
} = Astro.props;

const veterinarySchema = {
  "@context": "https://schema.org",
  "@type": ["VeterinaryCare", "PetStore", "LocalBusiness"],
  "@id": "https://cuidafilhopetshop.com.br/#petshop",
  "name": PETTOWN_DATA.brand.fullName,
  "alternateName": "Cuida Filho Pet Shop",
  "description": PETTOWN_DATA.brand.bio,
  "telephone": "+55-81-99184-1337",
  "priceRange": "$$",
  "openingHours": "Mo-Sa 08:00-20:00, Su 08:00-14:00",
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": "5.0",
    "reviewCount": "2800",
    "bestRating": "5",
    "worstRating": "1"
  },
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "Av. Dezessete de Agosto, Casa Forte (Mateus Hiper)",
    "addressLocality": "Recife",
    "addressRegion": "PE",
    "addressCountry": "BR"
  },
  "geo": {
    "@type": "GeoCoordinates",
    "latitude": -8.0315,
    "longitude": -34.9190
  },
  "sameAs": [
    PETTOWN_DATA.brand.instagram
  ]
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": PETTOWN_DATA.faq.items.map((item) => ({
    "@type": "Question",
    "name": item.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": item.answer
    }
  }))
};
---

<!DOCTYPE html>
<html lang="pt-BR" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><text y=%22.9em%22 font-size=%2290%22>🐾</text></svg>" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content="cuida filho pet shop, pet shop casa forte recife, banho e tosa casa forte, consulta veterinaria mateus hiper, racoes medicamentos recife, vacinacao pet recife, veterinario zona norte recife" />
    <meta name="author" content="Cuida Filho Pet Shop" />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <link rel="canonical" href="https://cuidafilhopetshop.com.br/" />

    <!-- Local SEO Geo-Tags para Casa Forte / Recife - PE -->
    <meta name="geo.region" content="BR-PE" />
    <meta name="geo.placename" content="Recife, Casa Forte" />
    <meta name="geo.position" content="-8.0315;-34.9190" />
    <meta name="ICBM" content="-8.0315, -34.9190" />

    <!-- OpenGraph / Facebook / WhatsApp Preview -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://cuidafilhopetshop.com.br/" />
    <meta property="og:site_name" content="Cuida Filho Pet Shop" />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:image" content="https://cuidafilhopetshop.com.br/assets/cuidafilhopetshoplogo.jpg" />
    <meta property="og:image:alt" content="Cuida Filho Pet Shop • Mateus Hiper Casa Forte" />

    <!-- Twitter Cards -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="https://cuidafilhopetshop.com.br/assets/cuidafilhopetshoplogo.jpg" />

    <!-- Schema.org JSON-LD para Google Rich Snippets (VeterinaryCare + LocalBusiness) -->
    <script type="application/ld+json" set:html={JSON.stringify(veterinarySchema)} />

    <!-- Schema.org JSON-LD para FAQPage (Google SERP Q&A Accordion e AI Citation) -->
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

    <!-- Google Fonts Preconnect & Typography (Fredoka, Baloo 2, Nunito, Quicksand) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Baloo+2:wght@500;600;700;800&family=Fredoka:wght@400;500;600;700;800&family=Nunito:wght@400;500;600;700;800&family=Quicksand:wght@400;500;600;700&display=swap" rel="stylesheet" />
  </head>
  <body class="bg-[#FFFDF7] text-[#4A2C11] antialiased font-sans selection:bg-[#FF8C00] selection:text-white overflow-x-hidden">
    <slot />

    <!-- Inicializador Universal de Scroll Reveal (Zero Dependências) -->
    <script is:inline>
      function setupScrollReveal() {
        const reveals = document.querySelectorAll(
          '.reveal:not(.is-revealed), .reveal-left:not(.is-revealed), .reveal-right:not(.is-revealed), .reveal-scale:not(.is-revealed)'
        );
        if (!reveals.length) return;

        if (!('IntersectionObserver' in window)) {
          reveals.forEach(function(el) { el.classList.add('is-revealed'); });
          return;
        }

        const observer = new IntersectionObserver(function(entries) {
          entries.forEach(function(entry) {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-revealed');
              observer.unobserve(entry.target);
            }
          });
        }, {
          threshold: 0.08,
          rootMargin: '0px 0px -30px 0px'
        });

        reveals.forEach(function(el) {
          const rect = el.getBoundingClientRect();
          if (rect.top < window.innerHeight && rect.bottom > 0) {
            el.classList.add('is-revealed');
          } else {
            observer.observe(el);
          }
        });
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', setupScrollReveal);
      } else {
        setupScrollReveal();
      }
      window.addEventListener('load', setupScrollReveal);
      document.addEventListener('astro:page-load', setupScrollReveal);
    </script>
  </body>
</html>
