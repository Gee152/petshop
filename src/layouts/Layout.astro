---
import '../index.css';
import { PETTOWN_DATA } from '../data/propertyData';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Pet Town | Pet Shop e Clínica Veterinária • Cuidado e Beleza 360°",
  description = "Feito por quem cuida com amor! Clínica Veterinária, Dra. Aline Belo (Acupuntura e Fisioterapia Veterinária), Banho & Tosa 360°, Farmácia e Pet Delivery."
} = Astro.props;

const veterinarySchema = {
  "@context": "https://schema.org",
  "@type": "VeterinaryCare",
  "name": PETTOWN_DATA.brand.fullName,
  "alternateName": "Pet Town",
  "description": PETTOWN_DATA.brand.bio,
  "telephone": "+55-81-99999-9999",
  "priceRange": "$$",
  "openingHours": "Mo-Fr 08:00-18:00, Sa 08:00-14:00",
  "address": {
    "@type": "PostalAddress",
    "addressLocality": "Recife",
    "addressRegion": "PE",
    "addressCountry": "BR"
  },
  "geo": {
    "@type": "GeoCoordinates",
    "latitude": -8.0476,
    "longitude": -34.8770
  }
};
---

<!DOCTYPE html>
<html lang="pt-BR" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><text y=%22.9em%22 font-size=%2290%22>🐾</text></svg>" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content="pet shop recife, clinica veterinaria recife, banho e tosa recife, acupuntura veterinaria aline belo, pet delivery leva e traz" />
    <meta name="author" content="Pet Town Pet Shop e Clínica Veterinária" />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href="https://pettown.com.br/" />

    <!-- OpenGraph / Facebook / WhatsApp Preview -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="pt_BR" />

    <!-- Schema.org JSON-LD para Google Rich Snippets (VeterinaryCare) -->
    <script type="application/ld+json" set:html={JSON.stringify(veterinarySchema)} />

    <!-- Google Fonts Preconnect & Typography -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Montserrat:wght@400;500;600;700;800;900&family=Outfit:wght@400;500;600;700;800;900&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Poppins:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  </head>
  <body class="bg-[#F8FAFC] text-slate-900 antialiased font-sans selection:bg-[#F97316] selection:text-white overflow-x-hidden">
    <slot />

    <!-- Inicializador Universal de Scroll Reveal (Zero Dependências) -->
    <script is:inline>
      function setupScrollReveal() {
        const reveals = document.querySelectorAll(
          '.reveal:not(.is-revealed), .reveal-left:not(.is-revealed), .reveal-right:not(.is-revealed), .reveal-scale:not(.is-revealed)'
        );
        if (!reveals.length) return;

        if (!('IntersectionObserver' in window)) {
          reveals.forEach(function(el) { el.classList.add('is-revealed'); });
          return;
        }

        const observer = new IntersectionObserver(function(entries) {
          entries.forEach(function(entry) {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-revealed');
              observer.unobserve(entry.target);
            }
          });
        }, {
          threshold: 0.08,
          rootMargin: '0px 0px -30px 0px'
        });

        reveals.forEach(function(el) {
          const rect = el.getBoundingClientRect();
          if (rect.top < window.innerHeight && rect.bottom > 0) {
            el.classList.add('is-revealed');
          } else {
            observer.observe(el);
          }
        });
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', setupScrollReveal);
      } else {
        setupScrollReveal();
      }
      window.addEventListener('load', setupScrollReveal);
      document.addEventListener('astro:page-load', setupScrollReveal);
    </script>
  </body>
</html>
